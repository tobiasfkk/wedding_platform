# Copie para /opt/wedding/.env.production na EC2 (permissão 600). NUNCA versione o arquivo real.
# Gere segredos com: openssl rand -base64 48

# Imagem do backend (tag = SHA do commit). Atualizada pelo script de deploy.
API_IMAGE=000000000000.dkr.ecr.sa-east-1.amazonaws.com/wedding-backend:troque-pelo-sha

# Rede pública
API_DOMAIN=api.casamentodudatobi.tobiaskiefer.com.br
ACME_EMAIL=troque@exemplo.com
PUBLIC_SITE_URL=https://casamentodudatobi.tobiaskiefer.com.br
AUTH_ALLOWED_ORIGINS=https://casamentodudatobi.tobiaskiefer.com.br

# Banco (acessível apenas pela rede interna do Compose)
POSTGRES_DB=wedding
POSTGRES_USER=wedding
POSTGRES_PASSWORD=TROQUE

# Convites: o pepper não pode mudar depois que os links forem enviados (veja ADR 0003)
INVITATION_CODE_PEPPER=TROQUE
INVITATION_CODE_PEPPER_VERSION=1

# Administrador inicial: usado só na primeira subida; remova a senha do arquivo depois do primeiro login
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Backup
BACKUP_S3_URI=s3://troque-o-bucket/wedding-backups
