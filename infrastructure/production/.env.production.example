# Referência do /opt/wedding/.env.production. Na EC2 ele é GERADO por scripts/configure-env.sh a
# partir de /opt/wedding/host.conf (gravado pelo template CloudFormation) e do AWS SSM Parameter
# Store (/wedding/production/*). Não edite o arquivo real à mão; nunca versione valores reais.

# Imagem do backend (tag = SHA do commit). Atualizada pelo deploy.sh.
API_IMAGE=ghcr.io/tobiasfkk/wedding-backend:<sha-do-commit>

# Rede pública
API_DOMAIN=api.casamentodudatobi.tobiaskiefer.com.br
ACME_EMAIL=troque@exemplo.com
PUBLIC_SITE_URL=https://casamentodudatobi.tobiaskiefer.com.br
AUTH_ALLOWED_ORIGINS=https://casamentodudatobi.tobiaskiefer.com.br

# Banco (acessível apenas pela rede interna do Compose)
POSTGRES_DB=wedding
POSTGRES_USER=wedding
POSTGRES_PASSWORD=<Parameter Store: /wedding/production/postgres-password>

# Convites: o pepper não pode mudar depois que os links forem enviados (veja ADR 0003)
INVITATION_CODE_PEPPER=<Parameter Store: /wedding/production/invitation-code-pepper>
INVITATION_CODE_PEPPER_VERSION=1

# Administrador inicial (criado só se o e-mail ainda não existir)
ADMIN_INITIAL_EMAIL=troque@exemplo.com
ADMIN_INITIAL_PASSWORD=<Parameter Store: /wedding/production/admin-password>

# Backup
BACKUP_S3_URI=s3://<bucket-do-template>/postgres
